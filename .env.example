ENVIRONMENT=local
DEBUG=false
DOCUMENT_STORAGE_PATH=data/documents

CHUNK_SIZE=1000
CHUNK_OVERLAP=200

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=document_chunks

OPENAI_API_KEY=
LLM_MODEL=gpt-5.6-luna
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.4

QDRANT_TIMEOUT_SECONDS=10
QDRANT_MAX_ATTEMPTS=3

OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

LOG_LEVEL=INFO

EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL_SECONDS=3600
EMBEDDING_CACHE_MAX_SIZE=1000

RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_TTL_SECONDS=300
RETRIEVAL_CACHE_MAX_SIZE=1000

DATABASE_URL=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

KUBERNETES_CONFIG_MODE=local
KUBERNETES_CONTEXT=
KUBERNETES_DEFAULT_NAMESPACE=ai-it-support-test

KUBERNETES_WRITE_ENABLED=false
KUBERNETES_RESTART_ALLOWED_NAMESPACES=dev,development
KUBERNETES_RESTART_ALLOWED_DEPLOYMENTS=

KUBERNETES_ROLLOUT_TIMEOUT_SECONDS=120
KUBERNETES_ROLLOUT_POLL_INTERVAL_SECONDS=5
KUBERNETES_ROLLOUT_MAX_READ_FAILURES=3


ACTION_WORKER_ENABLED=false
ACTION_WORKER_POLL_INTERVAL_SECONDS=2
ACTION_WORKER_BATCH_SIZE=5
ACTION_WORKER_STALE_AFTER_SECONDS=300

MCP_ENABLED=false
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_ISSUER_URL=http://127.0.0.1:8000
MCP_RESOURCE_SERVER_URL=http://127.0.0.1:8001/mcp

AUTH_MODE=demo

OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
OIDC_REQUIRED_SCOPE=ai-support.access

POLICY_PDP_MODE=local

OPA_URL=http://127.0.0.1:8181
OPA_POLICY_PATH=ai_it_support/authz/decision
OPA_TIMEOUT_SECONDS=2
OPA_MAX_ATTEMPTS=2
OPA_HEALTH_CHECK_ENABLED=true

POLICY_SHADOW_PDP_ENABLED=false

OPA_BUNDLE_ENABLED=false
OPA_BUNDLE_NAME=ai-it-support-authz
OPA_REQUIRE_BUNDLE_READY=true

POLICY_INPUT_VERSION=1

OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-it-support-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_ENVIRONMENT=development

METRICS_ENABLED=true
WORKER_METRICS_PORT=9101